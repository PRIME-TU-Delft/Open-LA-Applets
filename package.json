    "@lucide/svelte": "^1.70.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/sveltekit": "^10.6.6",
    "@svelte-put/qr": "^2.1.3",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.9.9",
    "@types/pngjs": "^6.0.5",
    "@vitest/browser": "^4.1.12",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.6",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "puppeteer": "^25.16.0",
    "puppeteer-cluster": "^0.25.0",
    "storybook": "^10.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.55.6",
    "@number-flow/svelte": "^0.4.2",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/adapter-node": "^5.5.8",
    "@threlte/core": "^8.7.0",
    "@threlte/extras": "^9.23.1",
    "@types/three": "^0.184.1",
